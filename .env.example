# Copie para .env.local e preencha. O .env.local fica fora do git.
#
# Tudo aqui é NEXT_PUBLIC_: o valor entra no JavaScript que vai para o navegador.
# São chaves públicas de cliente por design. Quem protege o dado são as Firestore
# Rules (no repositório semestre-4-flutter) e o RLS do Supabase.

# Firebase — use a chave WEB (restrita por referenciador), não a do Android
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase — a chave sb_publishable_... (as anon keys legadas estão desativadas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
